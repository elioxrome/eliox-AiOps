JENKINS_URL=http://host.docker.internal:8080
JENKINS_USERNAME=
JENKINS_TOKEN=
JENKINS_TIMEOUT_SECONDS=30

LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:1.7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=400
LLM_JSON_MODE=true

DOCKER_LLM_PROVIDER=ollama
DOCKER_LLM_BASE_URL=http://ollama:11434
DOCKER_LLM_MODEL=qwen3:1.7b
DOCKER_LLM_API_KEY=

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60

DOCKER_EMBEDDING_PROVIDER=ollama
DOCKER_EMBEDDING_BASE_URL=http://ollama:11434
DOCKER_EMBEDDING_MODEL=embeddinggemma
DOCKER_EMBEDDING_API_KEY=
MAX_LOG_CHARACTERS=4000
DATABASE_PATH=data/jenkins-aiops.db
DASHBOARD_LIMIT=100
INGESTION_TOKEN=replace-with-a-random-secret
JENKINS_POLL_ENABLED=true
JENKINS_POLL_INTERVAL_SECONDS=15
JENKINS_POLL_JOBS=*
